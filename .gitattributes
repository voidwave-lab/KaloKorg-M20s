# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Rust & Web source files
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.html text eol=lf
*.yml text eol=lf

# Binary reference schematics, manuals, and audio files
*.jpg binary
*.jpeg binary
*.png binary
*.pdf binary
*.docx binary
*.wav binary
